{
  "name": "example",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "install-radar": "npm un react-native-radar ; npm i --install-links ../",
    "install-radar-rebuild-dirty": "npm run install-radar && expo prebuild --no-clean",
    "install-radar-rebuild": "npm run install-radar && expo prebuild --clean"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@maplibre/maplibre-react-native": "^11.0.0",
    "expo": "^57.0.23",
    "expo-build-properties": "~57.0.20",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-radar": "file:..",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "private": true,
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:8081"
}
